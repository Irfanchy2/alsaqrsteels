# ── Supabase (public, safe in the browser) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://ajurellftenxollyfahb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_wZ3tx4ZXlWG585K_8CaObA_OJofFRrm

# Public media bucket; when set, workshop photos load from Supabase Storage
# instead of /public (leave empty for fully offline development).
NEXT_PUBLIC_MEDIA_BASE=https://ajurellftenxollyfahb.supabase.co/storage/v1/object/public/media

# ── Enquiry pipeline (server only) ─────────────────────────────────────
# Shared secret between the website and the `submit-enquiry` edge function.
# Must equal public.app_config.value where key = 'enquiry_function_secret'.
ENQUIRY_FUNCTION_SECRET=

# ── Site ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://alsaqrsteels.com
# Only "true" on the final production domain. Anything else = noindex (staging).
NEXT_PUBLIC_SITE_INDEXABLE=false
# Arabic (RTL) routes stay off until translations are approved.
NEXT_PUBLIC_ENABLE_ARABIC=false
# Cookie-less Vercel Web Analytics; enable in the Vercel dashboard first.
NEXT_PUBLIC_VERCEL_ANALYTICS=false

# ── AI project assistant (server only; assistant hides itself if unset) ─
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-4-5
ASSISTANT_DAILY_CAP=1500

# ── Development only ───────────────────────────────────────────────────
# CONTENT_SOURCE=seed   read content from src/lib/content/seed.ts, not Supabase
# ENQUIRY_MOCK=1        fake enquiry backend (ignored on Vercel)

# Email notifications are configured on the Supabase edge function, not here:
#   supabase secrets set RESEND_API_KEY=... NOTIFY_EMAIL_TO=... NOTIFY_EMAIL_FROM=...
